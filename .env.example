# === Ollama ===
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# === API RAG ===
# Modelo LLM padrão (deve existir no Ollama: `docker exec ollama ollama pull phi3`)
LLM_MODEL=phi3
# Modelo de embedding local (cache em data/api/embeddings)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://qdrant:6333
LOG_LEVEL=INFO

# === OpenWebUI ===
# OLLAMA_BASE_URL já cobre
